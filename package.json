{
  "name": "kailah-wallet",
  "private": true,
  "version": "2.7.8",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:extension": "vite build --config vite.extension.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:offline": "for s in keys txbuild txv2 qrparse vault scanner hw pending netprefs failover swapgate lookalike trondecode bitcore amounts sw headers; do npx tsx scripts/check-$s.mjs || exit 1; done",
    "check:live": "for s in account evm sol solswap solstake tron; do npx tsx scripts/check-$s.mjs || exit 1; done",
    "digest": "node scripts/build-digest.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@scure/btc-signer": "1.8.1",
    "jsqr": "1.4.0",
    "micro-sol-signer": "0.8.2",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "sharp": "0.35.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
